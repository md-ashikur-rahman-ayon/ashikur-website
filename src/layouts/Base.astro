---
import { ClientRouter } from 'astro:transitions';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  path: string;
  type?: 'website' | 'article' | 'profile';
  jsonLd?: object | object[];
  published?: string;
  noindex?: boolean;
}
const { title, description, path, type = 'website', jsonLd, published, noindex = false } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://ashikur.safeshare.co';
const url = site + (path.endsWith('/') ? path : path + '/');
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang="en" transition:animate="none">
<head>
<meta charset="utf-8">
<script is:inline>(function(){var d=document.documentElement,on=function(){d.classList.add('fl')};try{if(sessionStorage.getItem('fl'))on()}catch(e){}if(!d.classList.contains('fl'))requestAnimationFrame(function(){setTimeout(function(){on();try{sessionStorage.setItem('fl','1')}catch(e){}},0)});document.addEventListener('astro:after-swap',on)})();</script>
<meta name="viewport" content="width=device-width,initial-scale=1">
<!-- Google tag (GTM-PFQ63M83), loaded after the page has finished so it never slows the first view -->
<script is:inline>(function(){if(window.__gtm)return;window.__gtm=1;window.dataLayer=window.dataLayer||[];window.gtag=function(){dataLayer.push(arguments)};gtag('js',new Date());var go=function(){setTimeout(function(){var s=document.createElement('script');s.async=true;s.src='https://www.googletagmanager.com/gtm.js?id=GTM-PFQ63M83';document.head.appendChild(s)},1200)};if(document.readyState==='complete')go();else window.addEventListener('load',go)})();</script>

<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={url}>
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}>
<meta name="author" content="Md Ashikur Rahman">
<link rel="author" href={site + '/about/'}>
<link rel="me" href="https://www.linkedin.com/in/md-ashikur-rahman-ayon/">
<link rel="me" href="https://x.com/md_ashikur_ayon">
<link rel="me" href="https://medium.com/@md_ashikur_rahman_ayon">
<meta property="og:type" content={type}>
<meta property="og:site_name" content="Md Ashikur Rahman">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={url}>
<meta property="og:image" content={site + '/og.jpg'}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Md Ashikur Rahman (Ashik), Rajshahi">
<meta property="og:locale" content="en_GB">
{type === 'article' && published && <meta property="article:published_time" content={published} />}
{type === 'article' && <meta property="article:author" content={site + '/about/'} />}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="@md_ashikur_ayon">
<meta name="twitter:creator" content="@md_ashikur_ayon">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={site + '/og.jpg'}>
<meta name="theme-color" content="#F3ECDD">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="sitemap" href="/sitemap-index.xml">
<link rel="alternate" type="application/rss+xml" title="The Notebook by Md Ashikur Rahman" href="/rss.xml">
<slot name="head" />
{ld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
<ClientRouter />
</head>
<body>
<div>
<slot />
</div>
<script>
  import { bindMusic } from '../scripts/music.js';
  import { initMotion } from '../scripts/motion.js';
  let ac: AbortController | undefined;
  document.addEventListener('astro:page-load', () => {
    ac?.abort();
    ac = new AbortController();
    bindMusic();
    initMotion(ac.signal);
  });
</script>
</body>
</html>
