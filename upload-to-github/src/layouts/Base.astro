---
import { ClientRouter } from 'astro:transitions';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  path: string;
  type?: 'website' | 'article' | 'profile';
  jsonLd?: object | object[];
}
const { title, description, path, type = 'website', jsonLd } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://ashikur.safeshare.co';
const url = site + (path.endsWith('/') ? path : path + '/');
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang="en" transition:animate="none">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={url}>
<meta property="og:type" content={type}>
<meta property="og:site_name" content="Md Ashikur Rahman">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={url}>
<meta property="og:image" content={site + '/og.jpg'}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="@md_ashikur_ayon">
<meta name="twitter:image" content={site + '/og.jpg'}>
<meta name="theme-color" content="#F3ECDD">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="sitemap" href="/sitemap-index.xml">
<link rel="preload" href="/fonts/bodoni-moda-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/newsreader-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin>
{ld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
<ClientRouter />
</head>
<body>
<div>
<slot />
</div>
<script>
  import { bindMusic } from '../scripts/music.js';
  import { initMotion } from '../scripts/motion.js';
  let ac: AbortController | undefined;
  document.addEventListener('astro:page-load', () => {
    ac?.abort();
    ac = new AbortController();
    bindMusic();
    initMotion(ac.signal);
  });
</script>
</body>
</html>
